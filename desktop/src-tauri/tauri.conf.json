{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studysh",
  "version": "0.1.1",
  "identifier": "com.oyayasu.studysh.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Studysh",
        "width": 1240,
        "height": 820,
        "minWidth": 860,
        "minHeight": 600,
        "backgroundColor": "#fbfaff"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Studysh vocabulary learning desktop application",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "resources": [
      "resources/uv.exe"
    ]
  }
}
